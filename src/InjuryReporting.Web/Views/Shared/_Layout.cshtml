<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] - SCA Injury Reporting</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">SCA Injury Reporting</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Create">Report an injury</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Mine">My reports</a></li>
                        }
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.SuperAdmin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Staff</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Incidents" asp-action="Index">Incidents</a></li>
                                    <li><a class="dropdown-item" asp-controller="Analytics" asp-action="Index">Analytics</a></li>
                                    <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Users</a></li>
                                    <li><a class="dropdown-item" asp-controller="Lookups" asp-action="Index">Pick lists</a></li>
                                    @if (User.IsInRole(AppRoles.SuperAdmin))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Audit" asp-action="Index">Audit log</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Manage" asp-action="Index">@User.Identity.Name</a></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4 flex-grow-1">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success" role="status">@ok</div>
        }
        @if (TempData["Warning"] is string warn)
        {
            <div class="alert alert-warning" role="alert">@warn</div>
        }
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted small">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.UtcNow.Year SCA Injury Reporting &middot; Treated as protected health information</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy &amp; data handling</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
