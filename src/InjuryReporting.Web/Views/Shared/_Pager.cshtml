@model PagerModel
@if (Model.TotalPages > 1)
{
    <nav aria-label="Pages">
        <ul class="pagination pagination-sm">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Model.UrlForPage(Model.Page - 1)">Previous</a></li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages (@Model.Total)</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Model.UrlForPage(Model.Page + 1)">Next</a></li>
        </ul>
    </nav>
}
