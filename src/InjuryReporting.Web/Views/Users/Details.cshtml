@model UserDetailsModel
@{
    ViewData["Title"] = "User";
    var u = Model.User;
}
<div class="mb-3"><a asp-action="Index">&larr; Users</a></div>
<h1 class="h3 mb-3">@u.Email</h1>

<div class="row g-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header">Account</div><div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@u.DisplayName</dd>
            <dt class="col-sm-4">Role</dt><dd class="col-sm-8">@u.Role</dd>
            <dt class="col-sm-4">Email confirmed</dt><dd class="col-sm-8">@(u.EmailConfirmed ? "Yes" : "No")</dd>
            <dt class="col-sm-4">Two-factor</dt><dd class="col-sm-8">@(u.TwoFactor ? "On" : "Off")</dd>
            <dt class="col-sm-4">Joined</dt><dd class="col-sm-8">@u.CreatedUtc.ToString("yyyy-MM-dd")</dd>
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                @if (u.IsSuspended) { <span class="badge text-bg-danger">Suspended</span> <span class="small d-block">@Model.SuspensionReason</span> }
                else { <span class="badge text-bg-success">Active</span> }
            </dd>
        </dl>
    </div></div></div>

    <div class="col-lg-6">
    @if (Model.IsSelf)
    {
        <div class="alert alert-info">This is your own account. Use <a asp-controller="Manage" asp-action="Index">My account</a> to change it.</div>
    }
    else
    {
        <div class="card mb-3"><div class="card-header">Moderation</div><div class="card-body">
        @if (u.IsSuspended)
        {
            <form asp-action="Unsuspend" method="post">
                <input type="hidden" name="id" value="@u.Id" />
                <button type="submit" class="btn btn-success">Reinstate user</button>
            </form>
        }
        else
        {
            <form asp-action="Suspend" method="post">
                <input type="hidden" name="Id" value="@u.Id" />
                <label for="Reason" class="form-label">Reason for suspension</label>
                <input id="Reason" name="Reason" class="form-control mb-2" maxlength="500" required />
                <button type="submit" class="btn btn-danger">Suspend and sign out</button>
            </form>
        }
        </div></div>

        @if (Model.ViewerIsSuperAdmin)
        {
            <div class="card mb-3 border-danger"><div class="card-header">Retrieve or delete data (Super Admin only)</div><div class="card-body">
                <p class="small">Retrieve everything held about this user as a JSON file: profile, reports filed under their account, and their account activity. Logged.</p>
                <a class="btn btn-outline-secondary btn-sm mb-3" asp-action="ExportData" asp-route-id="@u.Id">Retrieve data (JSON)</a>
                <hr />
                <p class="small mb-2"><strong>Delete this user and their data.</strong> This is permanent. Their sign-in and profile are removed and their email and IP are erased from the audit log (the event itself stays).</p>
                <form asp-action="DeleteUser" method="post">
                    <input type="hidden" name="Id" value="@u.Id" />
                    <div class="form-check"><input class="form-check-input" type="radio" name="DeleteReports" id="ud-yes" value="true" checked /><label class="form-check-label small" for="ud-yes">Also delete every report filed under their account</label></div>
                    <div class="form-check mb-2"><input class="form-check-input" type="radio" name="DeleteReports" id="ud-no" value="false" /><label class="form-check-label small" for="ud-no">Keep their reports in the statistics, unlinked</label></div>
                    <label for="ConfirmEmail" class="form-label small">Type <span class="mono">@u.Email</span> to confirm</label>
                    <input id="ConfirmEmail" name="ConfirmEmail" class="form-control form-control-sm mb-2" autocomplete="off" required />
                    <label for="AdminPassword" class="form-label small">Your password</label>
                    <input id="AdminPassword" name="AdminPassword" type="password" class="form-control form-control-sm mb-2" autocomplete="current-password" required />
                    <button type="submit" class="btn btn-danger btn-sm">Permanently delete user</button>
                </form>
            </div></div>

            <div class="card"><div class="card-header">Role (Super Admin only)</div><div class="card-body">
                <form asp-action="SetRole" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="id" value="@u.Id" />
                    <div class="col-sm-8">
                        <label for="role" class="form-label">Role</label>
                        <select id="role" name="role" class="form-select">
                            @foreach (var role in AppRoles.All)
                            {
                                <option value="@role" selected="@(role == u.Role)">@role</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-4"><button type="submit" class="btn btn-primary">Update</button></div>
                </form>
                <div class="form-text mt-2">Staff roles require two-factor authentication. Changes sign the user out within a minute.</div>
            </div></div>
        }
    }
    </div>
</div>
