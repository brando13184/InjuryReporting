@model ChangeEmailModel
@{ ViewData["Title"] = "Change email"; }
<div class="row justify-content-center"><div class="col-md-7 col-lg-5">
    <div class="card"><div class="card-body p-4">
        <h1 class="h4 mb-3">Change email address</h1>
        <p class="text-muted">Your email is your sign-in name. We'll send a confirmation link to the new address; nothing changes until you click it.</p>
        <form asp-action="ChangeEmail" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="NewEmail" class="form-label"></label>
                <input asp-for="NewEmail" class="form-control" autocomplete="off" />
                <span asp-validation-for="NewEmail" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Send confirmation link</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
